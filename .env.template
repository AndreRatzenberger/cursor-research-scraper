# LLM Configuration
# The model to use for text generation (summaries, analysis, etc.)
# Examples: "gpt-4", "gpt-3.5-turbo", "claude-3-opus-20240229"
DEFAULT_MODEL=gpt-3.5-turbo

# The model to use for embeddings
# Examples: "text-embedding-3-small", "text-embedding-ada-002"
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
# Port for the backend API
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database path (TinyDB JSON file)
DB_PATH=./data/papertrail.json

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
